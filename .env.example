# Local application URLs
TAIGA_SCHEME=http
TAIGA_DOMAIN=localhost:9000
SUBPATH=
WEBSOCKETS_SCHEME=ws

# Disposable local-development defaults. Never use them in production.
SECRET_KEY=change-me-local-only
TAIGA_SECRET_KEY=change-me-local-only

# PostgreSQL
TAIGA_DB_HOST=taiga-db
TAIGA_DB_PORT=5432
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD=taiga

# RabbitMQ
RABBITMQ_USER=taiga
RABBITMQ_PASS=taiga
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=secret-erlang-cookie

# Compatibility with older Taiga Docker variable names
TAIGA_ASYNC_RABBITMQ_USER=taiga
TAIGA_ASYNC_RABBITMQ_PASS=taiga
TAIGA_ASYNC_RABBITMQ_VHOST=taiga
TAIGA_ASYNC_RABBITMQ_HOST=taiga-async-rabbitmq
TAIGA_ASYNC_RABBITMQ_PORT=5672
TAIGA_EVENTS_RABBITMQ_USER=taiga
TAIGA_EVENTS_RABBITMQ_PASS=taiga
TAIGA_EVENTS_RABBITMQ_VHOST=taiga
TAIGA_EVENTS_RABBITMQ_HOST=taiga-events-rabbitmq
TAIGA_EVENTS_RABBITMQ_PORT=5672

# Email defaults for local development
EMAIL_BACKEND=console
EMAIL_DEFAULT_FROM=changeme@example.com
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST=smtp.host.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user
EMAIL_HOST_PASSWORD=change-me-local-only

# Optional settings
ENABLE_TELEMETRY=False
ATTACHMENTS_MAX_AGE=360
